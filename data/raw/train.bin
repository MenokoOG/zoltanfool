        return Task(
            config=self.tasks_config["reporting_task"],  # type: ignore[index]
            context=[self.research_task()],
        )

    @crew
    def crew(self) -> Crew:
        """Creates the flight-aviation AI research crew."""
        return Crew(
            agents=self.agents,
            tasks=self.tasks,
            process=Process.sequential,
            verbose=True,
        )

