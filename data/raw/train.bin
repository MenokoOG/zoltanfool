        gr.Markdown("*💡 Tip: Be specific in your research queries for better results. The system will create a comprehensive report and email it to you.*")
    
    # Set up the interface interactions
    msg.submit(
        process_research_request,
        inputs=[msg, chatbot],
        outputs=[chatbot, msg],
        show_progress="full"
    )
    
    send_btn.click(
        process_research_request,
        inputs=[msg, chatbot],
        outputs=[chatbot, msg],
        show_progress="full"
    )
    
    clear.click(
        lambda: ([], ""),
        outputs=[chatbot, msg]
    )

