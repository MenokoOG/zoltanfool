        planner_agent.as_tool(
            tool_name="planner",
            tool_description="Create a focused search plan given query and clarifications"
        ),
        search_agent.as_tool(
            tool_name="search",
            tool_description="Summarize web search results for a given term"
        ),
        writer_agent.as_tool(
