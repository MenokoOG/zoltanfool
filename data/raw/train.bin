        include_git_diff=False
    ):
        print(f"📝 {status}")
        # The last item will be the final result
        final_result = status
    
    return final_result


if __name__ == "__main__":
    print("Starting module test...\n")
    result = asyncio.run(test_basic_analysis())
    print("\n✅ Module test complete!")


