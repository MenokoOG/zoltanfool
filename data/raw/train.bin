        "cbrn_threshold": "Bioweapon Uplift CCL",
        "ai_rd_threshold": "ML R&D Acceleration CCL (v2.0 raised security tier)",
        "adjustment_clause": "yes; added 2025",
        "safety_case": "per-CCL; Deceptive Alignment section added v2.0",
