                lines=4
            )
            submit_btn = gr.Button("⚡ Run Agent Strategy", variant="primary")
        with gr.Column(scale=3):
            output_md = gr.Markdown("### Agent Output\nSystem standby...")
            
    submit_btn.click(handle_query, inputs=input_text, outputs=output_md)

