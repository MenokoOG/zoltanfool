from agents import add_trace_processor
from dotenv import load_dotenv

_CONTRIB_DIR = Path(__file__).resolve().parent
if str(_CONTRIB_DIR) not in sys.path:
    sys.path.insert(0, str(_CONTRIB_DIR))

