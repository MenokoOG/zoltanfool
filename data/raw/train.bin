    """
    Get the current price of a cryptocurrency.

    Args:
        symbol: Crypto symbol such as BTC, ETH, or SOL
    """
    symbol = symbol.upper()

    if not is_crypto(symbol):
        raise ValueError(f"{symbol} is not a supported crypto asset")

    return get_crypto_price(symbol)


