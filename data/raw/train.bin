    invalid_order = {
        "order_id": "ORD-002",
        "customer": {"name": "Bob"},
        "items": [],
        "total": -10,
    }

    print(f"\n  Order schema (nested objects + arrays):")
    for data, label in [(valid_order, "Valid order"), (invalid_order, "Invalid order")]:
