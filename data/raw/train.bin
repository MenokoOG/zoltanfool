def final_report_node(state):
    report = "=== Career Advice Report ===\n\n"

    report += "Recommended Roles:\n"
    for role in state["roles"]:
        report += f"- {role}\n"

    report += "\nSkill Gaps:\n"
    for role, gaps in state["skill_gaps"].items():
        report += f"{role}: {', '.join(gaps) if gaps else 'None'}\n"

    report += "\n" + state["learning_plan"]

    state["final_report"] = report
    return state
def manager_node(state):
    user = state["user_input"]

    if not user.get("goal"):
        state["next_step"] = "clarifier"
    else:
        state["next_step"] = "research"

    return state
from data.roles import ROLE_SKILLS

def research_node(state):
    goal = state["user_input"]["goal"]

    roles = [role for role in ROLE_SKILLS if goal.lower() in role.lower()]

    if not roles:
        roles = ["Software Engineer"]

    state["roles"] = roles
    return state
from typing import TypedDict, List, Dict

class CareerState(TypedDict):
    user_input: dict
    clarified: bool
    roles: List[str]
    skill_gaps: Dict[str, List[str]]
    learning_plan: str
    final_report: str
    next_step: str
