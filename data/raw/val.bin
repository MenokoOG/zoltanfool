    ("ETH-YRG", "medium"): ["stone fruit", "honey", "tea-like"],
    ("COL-HUI", "light"): ["caramel", "red apple", "bright"],
    ("COL-HUI", "medium"): ["chocolate", "nutty", "balanced"],
    ("BRA-SMO", "medium"): ["chocolate", "peanut", "low acid"],
